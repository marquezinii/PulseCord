{
  "name": "pulsecord",
  "version": "0.2.0",
  "private": true,
  "description": "Independent, open-source desktop shell for Discord with a clean-room plugin runtime",
  "homepage": "https://github.com/marquezinii/PulseCord",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marquezinii/PulseCord.git"
  },
  "bugs": {
    "url": "https://github.com/marquezinii/PulseCord/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "PulseCord contributors",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && npm run test && npm run verify:independence",
    "dev": "npm run build && electron .",
    "package:dir": "npm run build && electron-builder --dir",
    "safe-mode": "npm run build && electron . --safe-mode",
    "shortcut:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "start": "npm run dev",
    "test": "node scripts/test.mjs",
    "verify:independence": "node scripts/verify-clean-room.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "build": {
    "appId": "app.pulsecord.desktop",
    "productName": "PulseCord",
    "executableName": "pulsecord",
    "asar": true,
    "files": [
      "dist/**",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "assets/discord-symbol.svg",
        "to": "brand/discord-symbol.svg"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "outputs"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        "dir"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        "dir"
      ]
    }
  }
}
